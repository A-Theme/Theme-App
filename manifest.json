{
  "name": "Aramaki's Tinfoil Theme Editor",
  "short_name": "Theme Editor",
  "description": "A visual, in-browser editor for Tinfoil theme.json files.",
  "start_url": "./tinfoil-theme-editor.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b1420",
